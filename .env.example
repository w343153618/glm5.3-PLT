# 复制为 .env 后按需修改（start.sh 首轮会自动复制并补 UID/GID）。
# 生产（公网 HTTPS）场景：COOKIE_SECURE 必须设 true。

# 宿主机监听地址：公网部署经 Caddy 反代，应用保持仅本机
BIND_ADDRESS=127.0.0.1

# 宿主机端口：Caddy（host 网络）占用 19888 对外，应用映射到 19889
ERP_PORT=19889

# 仅显式设 true 才加载合成演示数据；生产保持 false
DEMO_SEED=false

# 初始口令（仅对尚未创建的账号生效；不重置已有账号）
AUTH_BOOTSTRAP_PASSWORD=

# HTTPS 公网访问设 true（Cookie 仅经安全连接传输）；本机 HTTP 调试用 false
COOKIE_SECURE=false

# 由 scripts/start.sh 首轮自动写入，勿手工预设
# ERP_UID=1000
# ERP_GID=1000
